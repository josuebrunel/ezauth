# Global Settings
EZAUTH_ADDR=":8080"
EZAUTH_BASE_URL="http://localhost:8080"
EZAUTH_DEBUG=false
EZAUTH_SECRET="your-app-secret"
EZAUTH_JWT_SECRET="your-super-secret-key"
EZAUTH_TIMEOUT="30s"

# Database Settings
EZAUTH_DB_DIALECT="sqlite3"
EZAUTH_DB_DSN="ezauth.db"

# OAuth2 Settings
EZAUTH_OAUTH2_CALLBACK_URL="http://localhost:3000/callback"

# Google
EZAUTH_OAUTH2_GOOGLE_CLIENT_ID="your-google-client-id"
EZAUTH_OAUTH2_GOOGLE_CLIENT_SECRET="your-google-client-secret"
EZAUTH_OAUTH2_GOOGLE_REDIRECT_URL="http://localhost:8080/auth/oauth2/google/callback"
EZAUTH_OAUTH2_GOOGLE_SCOPES="email,profile"

# GitHub
EZAUTH_OAUTH2_GITHUB_CLIENT_ID="your-github-client-id"
EZAUTH_OAUTH2_GITHUB_CLIENT_SECRET="your-github-client-secret"
EZAUTH_OAUTH2_GITHUB_REDIRECT_URL="http://localhost:8080/auth/oauth2/github/callback"
EZAUTH_OAUTH2_GITHUB_SCOPES="user:email"

# Facebook
EZAUTH_OAUTH2_FACEBOOK_CLIENT_ID="your-facebook-client-id"
EZAUTH_OAUTH2_FACEBOOK_CLIENT_SECRET="your-facebook-client-secret"
EZAUTH_OAUTH2_FACEBOOK_REDIRECT_URL="http://localhost:8080/auth/oauth2/facebook/callback"
EZAUTH_OAUTH2_FACEBOOK_SCOPES="email"

# Discord
EZAUTH_OAUTH2_DISCORD_CLIENT_ID="your-discord-client-id"
EZAUTH_OAUTH2_DISCORD_CLIENT_SECRET="your-discord-client-secret"
EZAUTH_OAUTH2_DISCORD_REDIRECT_URL="http://localhost:8080/auth/oauth2/discord/callback"
EZAUTH_OAUTH2_DISCORD_SCOPES="identify,email"

# GitLab
EZAUTH_OAUTH2_GITLAB_CLIENT_ID="your-gitlab-client-id"
EZAUTH_OAUTH2_GITLAB_CLIENT_SECRET="your-gitlab-client-secret"
EZAUTH_OAUTH2_GITLAB_REDIRECT_URL="http://localhost:8080/auth/oauth2/gitlab/callback"
EZAUTH_OAUTH2_GITLAB_SCOPES="read_user"

# Slack
EZAUTH_OAUTH2_SLACK_CLIENT_ID="your-slack-client-id"
EZAUTH_OAUTH2_SLACK_CLIENT_SECRET="your-slack-client-secret"
EZAUTH_OAUTH2_SLACK_REDIRECT_URL="http://localhost:8080/auth/oauth2/slack/callback"
EZAUTH_OAUTH2_SLACK_SCOPES="openid,email"

# LinkedIn
EZAUTH_OAUTH2_LINKEDIN_CLIENT_ID="your-linkedin-client-id"
EZAUTH_OAUTH2_LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
EZAUTH_OAUTH2_LINKEDIN_REDIRECT_URL="http://localhost:8080/auth/oauth2/linkedin/callback"
EZAUTH_OAUTH2_LINKEDIN_SCOPES="openid,profile,email"

# Spotify
EZAUTH_OAUTH2_SPOTIFY_CLIENT_ID="your-spotify-client-id"
EZAUTH_OAUTH2_SPOTIFY_CLIENT_SECRET="your-spotify-client-secret"
EZAUTH_OAUTH2_SPOTIFY_REDIRECT_URL="http://localhost:8080/auth/oauth2/spotify/callback"
EZAUTH_OAUTH2_SPOTIFY_SCOPES="user-read-email,user-read-private"

# Custom Providers Configuration (for providers not in the built-in list)
# Comma-separated list of custom provider names to register
EZAUTH_OAUTH2_PROVIDERS="okta"

# Custom Provider: Okta (OIDC Discovery)
EZAUTH_OAUTH2_OKTA_CLIENT_ID="your-okta-client-id"
EZAUTH_OAUTH2_OKTA_CLIENT_SECRET="your-okta-client-secret"
EZAUTH_OAUTH2_OKTA_REDIRECT_URL="http://localhost:8080/auth/oauth2/okta/callback"
EZAUTH_OAUTH2_OKTA_SCOPES="openid,profile,email"
EZAUTH_OAUTH2_OKTA_ISSUER_URL="https://your-domain.okta.com"

# SMTP Settings
EZAUTH_SMTP_HOST=""
EZAUTH_SMTP_PORT=587
EZAUTH_SMTP_USER=""
EZAUTH_SMTP_PASSWORD=""
EZAUTH_SMTP_FROM="noreply@example.com"
